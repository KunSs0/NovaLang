import java java.io.File
import java java.lang.Math
import java java.lang.StringBuilder
import java java.util.Date

// Java 互操作补全示例：使用 Nova 集合语法糖和显式 Java import。
// 测试: 在变量后输入 . 触发补全，应弹出 Java 类的 public 方法

// === JDK 类（无需配置 classpath） ===

// Nova 可变列表
val list = mutableListOf()
list.add("hello")
list.add("world")
println(list.size())
println(list.get(0))
// 测试: 输入 list. 应弹出 add(), get(), size(), remove(), clear(), contains() 等
list.add("")


// Nova 可变映射
val map = mutableMapOf()
map.put("name", "Nova")
map.put("version", "1.0")
println(map.get("name"))
// 测试: 输入 map. 应弹出 put(), get(), remove(), size(), containsKey() 等
map.getOrDefault("name",listOf())
// StringBuilder
val sb = StringBuilder()
sb.append("Hello")
sb.append(" ")
sb.append("World")

println(sb.toString())
// 测试: 输入 sb. 应弹出 append(), toString(), length(), insert(), delete() 等

// File
val file = File(".")
// 测试: 输入 file. 应弹出 exists(), getName(), getPath(), isDirectory() 等

// Math 静态方法通过显式导入的类型直接调用
val squareRoot = Math.sqrt(16.0)
println(squareRoot)

// === 类型注解形式 ===
val date = Date()
println(date)


